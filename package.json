{
  "name": "local-music-player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/src/server.cjs",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "concurrently \"npm run backend\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "server": "node server/syncServer.cjs",
    "backend": "node backend/src/server.cjs",
    "test:session": "node tests/sessionManager.test.cjs",
    "test:resync": "node tests/manualResyncEdgeCases.test.cjs",
    "test:server": "node tests/syncServer.test.cjs",
    "test:e2e": "node tests/endToEndSync.test.cjs",
    "test:share": "node tests/shareWorkflow.test.cjs",
    "test:timing": "node tests/playbackTiming.test.cjs",
    "test:cors": "node tests/cors.test.cjs",
    "test:media": "node tests/mediaUpload.test.cjs",
    "test": "node tests/sessionManager.test.cjs && node tests/manualResyncEdgeCases.test.cjs && node tests/syncServer.test.cjs && node tests/endToEndSync.test.cjs && node tests/shareWorkflow.test.cjs && node tests/playbackTiming.test.cjs && node tests/cors.test.cjs && node tests/mediaUpload.test.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "music-metadata": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
