# ==============================================================================
# SyncBeat Backend Environment Configuration Template
# ==============================================================================

PORT=3001
NODE_ENV=development

# CORS Settings
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Cloudinary Credentials (never expose to frontend clients)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Audius API Configuration (Online Music Streaming & Discovery)
AUDIUS_APP_NAME=SyncBeat
# Optional Audius API Key (leave empty for standard public tier; provides elevated rate limits if set)
AUDIUS_API_KEY=
