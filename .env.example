# ==============================================================================
# SyncBeat Environment Configuration Template
# Copy this file to '.env' and fill in your actual values.
# Do NOT commit actual secrets or '.env' to version control.
# ==============================================================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Permitted CORS Origins (comma-separated list or specific URL)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Cloudinary Integration (Playlist Cover Art, Album Artwork & Profiles)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Frontend Overrides (Vite exposes VITE_* to browser)
# VITE_API_URL=http://localhost:3001
# VITE_SOCKET_URL=http://localhost:3001
